#!/usr/bin/env python3
"""Record that the design system has been re-synced with the watched design files.

Usage:
    design-sync-mark                   mark as synced now
    design-sync-mark --org-url URL     also record the design-system org URL (kept across later runs)

Writes <state>/design-system-synced.json with synced_repo_sha, synced_design_sha (last commit
touching any config `design_watched_files` entry), synced_at, watched_files,
claude_design_org_url and schema_version.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _design_sync as ds  # noqa: E402
import _lib  # noqa: E402


def main() -> int:
    ap = argparse.ArgumentParser(prog="design-sync-mark")
    ap.add_argument("--org-url", default=None)
    args = ap.parse_args(sys.argv[1:])

    root = _lib.repo_root()
    cfg = _lib.load_config(root)
    if not ds.enabled(cfg):
        print(ds.DISABLED_MESSAGE)
        return 0

    marker = ds.marker_path(root, cfg)
    org_url = args.org_url
    if org_url is None and marker.is_file():
        try:
            previous = _lib.read_json(marker)
            org_url = previous.get("claude_design_org_url") if isinstance(previous, dict) else None
        except (json.JSONDecodeError, OSError):
            org_url = None

    files = ds.watched_files(cfg)
    repo_sha = _lib.git(root, "rev-parse", "HEAD")
    now = _lib.now_iso()
    record = {
        "schema_version": 1,
        "synced_repo_sha": repo_sha,
        "synced_design_sha": ds.design_sha(root, files),
        "synced_at": now,
        "watched_files": files,
        "claude_design_org_url": org_url,
    }
    _lib.write_json(marker, record)
    print(f"design-sync-mark: marked synced at {now}")
    print(f"  synced_repo_sha:   {record['synced_repo_sha']}")
    print(f"  synced_design_sha: {record['synced_design_sha']}")
    print(f"  marker:            {_lib.repo_relpath(root, marker)}")
    return 0


if __name__ == "__main__":
    _lib.run_main(main)
