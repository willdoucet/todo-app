#!/usr/bin/env python3
"""Workflow status: the SessionStart banner plus next-step, dashboard, history and epic views.

Usage:
    workflow-state                      plain-text banner (fail-silent: any error -> exit 0, no output)
    workflow-state --json               banner wrapped in the Claude Code SessionStart envelope (fail-silent)
    workflow-state --next [--json]      the single next step for this branch
    workflow-state --dashboard [--json] review readiness table + verdict for this branch's plan
    workflow-state --history [N] [--json]  last N completions across the registry (default 10)
    workflow-state --epics [--json]     every epic with derived milestone progress

Inputs: plan frontmatter, the plan's registry entry, the review log (the latest entry per
skill logged against THIS plan file, read through `_lib.review_disposition` so legacy words
and `resolved` records mean one thing), the count of unreadable log lines, the summary
file's step boxes, and epic progress derived by _lib.epic_progress. One pure function,
`gate_state`, turns the dispositions into the Open list, `missing`, `missing_to_ship`, and
the verdict; `--next`, `--dashboard`, and the banner all read from it and cannot disagree.
A review reads `stale` when a later review declared it must run again (`rereview` on the
declarer's entry); stale blocks like failed, its dashboard row reads `stale !`, and only its
own re-run clears it. `Concern:` lines (a review's own `concern` field) and the `Reason:`
line (the plan's frontmatter `reason`) are shown under the Open lines and gate nothing.
Nothing here is project-specific; branches, paths and skill names come from config, git and
the log.

Registry fields read (written by obsidian-workflow): key, kind, title, branch, plan,
commit, implementation_status, completed, parent_epic, milestone, updated_at.
"""

from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _lib  # noqa: E402

KNOWN_STATUSES = {
    "not-started",
    "implementing",
    "ready-for-review",
    "shipped",
    "abandoned",
    "blocked",
    "needs-context",
}
STUCK_STATUSES = ("ready-for-review", "implementing")
TERMINAL_STATUSES = ("shipped", "abandoned")

HARNESS_NOTE = "skill invocation syntax depends on the harness (/name or $name)"
OK_DISPOSITIONS = ("passed", "resolved")
BLOCKING = ("failed", "stale")  # a review that ran and is not ok: it ran and failed, or a later review sent it back


# --------------------------------------------------------------------------
# State gathering
# --------------------------------------------------------------------------


def summary_progress(plan: Path) -> tuple[int, int] | None:
    summary = _lib.summary_path_for(plan)
    if not summary.is_file():
        return None
    text = _lib.read_text(summary)
    done = len(re.findall(r"\[(?:✓|x|X)\]", text))
    pending = len(re.findall(r"\[ \]", text))
    failed = len(re.findall(r"\[✗\]", text))
    total = done + pending + failed
    return (done, total) if total else None


def infer_status(fm: dict, entry: dict | None) -> str:
    for value in (
        fm.get("implementation_status"),
        (entry or {}).get("implementation_status"),
        fm.get("workflow_status"),
    ):
        if isinstance(value, str) and value in KNOWN_STATUSES:
            return value
    return "not-started"


def stuck_entries(root: Path, cfg: dict, branch: str | None) -> list[dict]:
    out = []
    for key, entry in _lib.registry_all(root, cfg).items():
        if key.startswith("epic:"):
            continue
        status = entry.get("implementation_status")
        if status in STUCK_STATUSES and entry.get("branch") != branch:
            out.append({"key": key, "branch": entry.get("branch") or "?", "status": status})
    return sorted(out, key=lambda e: (e["branch"], e["key"]))


def gather(root: Path, cfg: dict) -> dict:
    branch = _lib.current_branch(root)
    base = _lib.base_branch(root, cfg)
    st: dict = {
        "root": root,
        "cfg": cfg,
        "branch": branch,
        "base": base,
        "on_base": branch == base,
        "plan": None,
        "plan_kind": None,
        "fm": {},
        "entry": None,
        "reviews": {},
        "unreadable": 0,
        "progress": None,
        "status": "not-started",
        "epic_slug": None,
        "epic": None,
        "milestone": None,
        "stuck": stuck_entries(root, cfg, branch),
    }
    if not branch:
        return st
    # The count is data, never an exception: the banner is fail-silent, and a raise here
    # would print nothing and leave the gate open.
    entries, bad = _lib.review_log_scan(root, cfg)  # one read: the count here, the entries to reviews_for_plan below
    st["unreadable"] = len(bad)
    plan, found_as = _lib.current_plan(root, cfg, branch)
    if not plan:
        return st
    fm = _lib.read_frontmatter(plan)
    plan_kind = _lib.plan_kind_of(fm, found_as)
    st.update(plan=plan, plan_kind=plan_kind, fm=fm)
    st["reviews"] = _lib.reviews_for_plan(root, cfg, plan.name, entries)
    if plan_kind == "epic":
        if plan.parent.parent == _lib.epics_dir(root, cfg):
            slug = _lib.epic_slug_from_path(plan)
        else:
            slug = fm.get("slug") or _lib.safe_branch(branch)
        st["epic_slug"] = slug
        st["entry"] = _lib.registry_get(root, cfg, _lib.epic_key(slug))
        st["epic"] = _lib.epic_progress(root, cfg, slug)
    else:
        key = fm.get("registry_key") or _lib.plan_key(branch)
        st["entry"] = _lib.registry_get(root, cfg, key)
        st["progress"] = summary_progress(plan)
        if fm.get("parent_epic"):
            st["epic_slug"] = str(fm["parent_epic"])
            st["milestone"] = str(fm.get("milestone") or "") or None
            st["epic"] = _lib.epic_progress(root, cfg, st["epic_slug"])
    st["status"] = infer_status(fm, st["entry"])
    return st


# --------------------------------------------------------------------------
# The gate
# --------------------------------------------------------------------------
#
# --next, top to bottom (the order of the checks IS the gate):
#
#   unreadable log lines? ──yes──▶ Warn: N unreadable … · verdict NOT CLEARED — review log unreadable
#                                  next.skill = null · Open and Optional empty · no Concern: or Reason: line
#   plan? ─no─▶ init / idle (unchanged)
#   epic? ─yes─▶ CEO missing → /plan-ceo-review "epic needs a CEO review" · blocking → its blocking reason · else milestones
#   status
#    not-started ──▶ eng not ok?  → /plan-eng-review  (missing: shipping gate | failed or stale: blocking reason)
#                    ui_scope and design not ok? → /plan-design-review
#                    first other blocking (failed or stale) gating review? → its invoke, blocking reason
#                       (a stale design review lands here even if ui_scope was switched off since)
#                    else → /execute-plan  (+ Optional: CEO, adversarial — only when MISSING; stale is not missing)
#    implementing · blocked · needs-context ──▶ next unchanged; every blocking gating review → Open: line
#                       (blocked / needs-context: Next: carries the plan's reason, through _lib.one_line)
#    ready-for-review ──▶ impl not ok? → /review-implementation
#                         first blocking gating review, any tier? → its invoke   (adversarial-subagent → /review-implementation;
#                                                                                a stale plan review re-runs here, scoped)
#                         final not ok? → /final-review (+ Optional /qa, /design-review when missing and ui_scope)
#                         else → /ship
#    shipped · abandoned ──▶ unchanged; no Open:, Concern: or Reason: lines
#
#   ok = passed | resolved · blocking = failed | stale · a gates=False tier (office-hours) never enters any list
#   missing         = eng (and design with ui_scope) not ok + every blocking plan-stage review
#   missing_to_ship = impl + final not ok + every blocking review of any gating tier
#   CLEARED TO SHIP iff missing_to_ship empty; else CLEARED FOR IMPLEMENTATION iff missing empty; else NOT CLEARED
#
#   blocking_reason: failed → failed_reason  "ran with issues open: …" (+ "re-review also demanded by …" when demanded)
#                    stale  → stale_reason   "re-review demanded by <invoke> (<date>): <note> — run this review again"
#   Concern: one line per tier whose latest run carries `concern`, in tier order; then Reason:, the plan's
#   frontmatter `reason`, unless it repeats a concern or the blocked branch already shows it. Display only.
#   Every free-text fragment on a line goes through _lib.one_line(…, DISPLAY_LIMIT); the line around it is never cut.


def invoke_of(skill: str) -> str:
    tier = _lib.tier_for(skill)
    return tier["invoke"] if tier else f"/{skill}"


def failed_reason(skill: str, reviews: dict, dispositions: dict) -> str:
    """Why a failed review is the next step, and what to do about it. When another gating
    tier already passed at or after the failure's `ts`, say so: the agent should log
    `resolved` by that review rather than re-run a long one it already closed. A failed review
    that is also demanded is never offered `resolved`: that would only turn it stale."""
    failed_ts = _lib.review_ts(reviews.get(skill))
    later = None
    for tier in _lib.gating_tiers():
        other = tier["skill"]
        if not _lib.can_resolve(skill, other):
            continue
        if dispositions.get(other) == "passed" and _lib.review_ts(reviews.get(other)) >= failed_ts:
            later = tier
            break
    prefix = "adversarial subagent ran with issues open: " if skill == "adversarial-subagent" else "ran with issues open: "
    demanded_by = (reviews.get(skill) or {}).get("demanded_by")
    if isinstance(demanded_by, str) and demanded_by:
        # resolving a failed-and-demanded review only turns it stale (_lib.reviews_for_plan), so the
        # line offers the one thing that works and never "log resolved"; the row's demanded_notes say what changed
        rerun = "re-run /review-implementation" if skill == "adversarial-subagent" else "re-run it"
        return f"{prefix}{rerun}; re-review also demanded by {invoke_of(demanded_by)} — resolving will not clear it, run this review again"
    if later:
        reason = (
            f"{prefix}{later['invoke']} already passed after this failure; confirm each open item is "
            f"closed and log resolved by {later['skill']}, or re-run this review"
        )
    elif skill == "adversarial-subagent":
        reason = f"{prefix}re-run /review-implementation, or confirm each finding is closed and log resolved"
    else:
        reason = f"{prefix}re-run it, or confirm each open item is closed and log resolved"
    return reason


def stale_reason(skill: str, reviews: dict) -> str:
    """Why a stale review is the next step: who demanded it, when, what changed, and the one
    thing that clears it. The note is flattened and cut at DISPLAY_LIMIT; the words around
    it are not, so "run this review again" survives any note."""
    entry = reviews.get(skill) or {}
    by, ts, count = entry.get("stale_by"), entry.get("stale_ts"), entry.get("stale_count")
    note = _lib.one_line(entry.get("stale_note", ""), _lib.DISPLAY_LIMIT)
    action = "re-run /review-implementation" if skill == "adversarial-subagent" else "run this review again"
    who = invoke_of(by) if isinstance(by, str) and by else "?"
    when = ts[:10] if isinstance(ts, str) else ""
    reason = f"re-review demanded by {who} ({when}): {note} — {action}"
    if isinstance(count, int) and count > 1:
        reason += f" (+{count - 1} more)"
    return reason


def blocking_reason(skill: str, reviews: dict, dispositions: dict) -> str:
    """One dispatcher for every blocking disposition, so a stale row can never print "ran with
    issues open" and a failed row never prints "re-review demanded"."""
    if dispositions.get(skill) == "stale":
        return stale_reason(skill, reviews)
    return failed_reason(skill, reviews, dispositions)


def gate_state(reviews: dict, fm: dict, status: str, unreadable: int) -> dict:
    """Pure. Dispositions per tier, the Open list, `missing`, `missing_to_ship`, and the
    verdict, from the latest entry per skill and the plan's frontmatter. Everything that
    routes or reports reads this; nothing recomputes it."""
    dispositions = {t["skill"]: _lib.review_disposition(reviews.get(t["skill"])) for t in _lib.REVIEW_TIERS}
    out = {
        "dispositions": dispositions,
        "open": [],
        "missing": [],
        "missing_to_ship": [],
        "verdict": "NOT CLEARED",
        "unreadable": unreadable,
    }
    if unreadable > 0:
        out["verdict"] = "NOT CLEARED — review log unreadable"
        return out

    def ok(skill: str) -> bool:
        return dispositions[skill] in OK_DISPOSITIONS

    impl_gate = ["plan-eng-review"] + (["plan-design-review"] if _lib.truthy(fm.get("ui_scope")) else [])
    for tier in _lib.gating_tiers():
        skill = tier["skill"]
        blocking = dispositions[skill] in BLOCKING
        if (skill in impl_gate and not ok(skill)) or (skill in _lib.PLAN_STAGE_SKILLS and blocking):
            out["missing"].append(skill)
        if (skill in _lib.SHIP_GATE_SKILLS and not ok(skill)) or blocking:
            out["missing_to_ship"].append(skill)
        if blocking and status not in TERMINAL_STATUSES:
            out["open"].append({"skill": skill, "invoke": tier["invoke"], "reason": blocking_reason(skill, reviews, dispositions)})
    if not out["missing_to_ship"]:
        out["verdict"] = "CLEARED TO SHIP"
    elif not out["missing"]:
        out["verdict"] = "CLEARED FOR IMPLEMENTATION"
    return out


def unreadable_reason(unreadable: int) -> str:
    return f"review log has {unreadable} unreadable line(s); resolve the conflict (keep both sides) before any review command"


# --------------------------------------------------------------------------
# Decision function
# --------------------------------------------------------------------------


def nxt(skill: str | None, args: str | None, required: bool, reason: str) -> dict:
    return {"skill": skill, "args": args, "required": required, "reason": reason}


def opt(skill: str, reason: str) -> dict:
    return {"skill": skill, "reason": reason}


def epic_summary(ep: dict, milestone: str | None = None) -> dict:
    index = None
    if milestone:
        ids = [m["id"] for m in ep["milestones"]]
        index = ids.index(milestone) + 1 if milestone in ids else None
    nm = ep.get("next")
    return {
        "slug": ep["slug"],
        "title": ep["title"],
        "epic_file": ep.get("epic_file"),
        "milestone": milestone,
        "index": index,
        "total": ep["total"],
        "shipped": ep["shipped"],
        "subsumed": ep["subsumed"],
        "in_progress": ep["in_progress"],
        "done": ep["done"],
        "next": {"id": nm["id"], "title": nm["title"], "size": nm["size"], "status": nm["status"]} if nm else None,
    }


def line_text(value) -> str:
    """Frontmatter and registry text on a status line: a milestone's id and title, an epic's
    slug, a branch, a risk tag. Free text like a reason, so it takes the same one helper."""
    return _lib.one_line(value if isinstance(value, str) else str(value), _lib.DISPLAY_LIMIT)


def milestone_next(ep: dict, ms: dict) -> dict:
    mid = line_text(ms["id"])
    label = line_text(f"{mid} {ms.get('title') or ''}")
    if ms["status"] in _lib.MILESTONE_ACTIVE_STATUSES:
        where = f" on branch {line_text(ms['branch'])}" if ms.get("branch") else ""
        return nxt(None, None, True, f"{label} is {ms['status']}{where} — switch to it and continue")
    skill = "/quickfix" if ms.get("size") == "quickfix" else "/office-hours"
    args = f"{ep['epic_file']}#{mid}" if ep.get("epic_file") else mid
    return nxt(skill, args, True, f"next milestone of {line_text(ep['slug'])}: {label}")


def active_epics(st: dict) -> list[dict]:
    """Every epic still in flight, derived once per invocation and kept on `st`: on the base
    branch `_decide` and `banner_lines` both ask, and each derivation re-reads the registry."""
    if "active_epics" not in st:
        out = []
        for slug in _lib.all_epic_slugs(st["root"], st["cfg"]):
            ep = _lib.epic_progress(st["root"], st["cfg"], slug)
            if ep["status"] in ("shipped", "abandoned") or ep["done"]:
                continue
            out.append(ep)
        st["active_epics"] = out
    return st["active_epics"]


def attention(st: dict, unreadable: int) -> dict:
    """Display only: each tier's latest-run `concern` (tier order, display-only tiers included;
    `reviews_for_plan` carries it onto a resolution record from the run it resolves) and the
    plan's frontmatter `reason`, both flattened and untruncated. Nothing reads either to decide
    anything. A shipped or abandoned plan, or an unreadable log, yields nothing."""
    if st["plan"] is None or unreadable > 0 or st["status"] in TERMINAL_STATUSES:
        return {"concerns": [], "reason": None, "reason_by": None, "reason_at": None}
    concerns = []
    for tier in _lib.REVIEW_TIERS:
        entry = st["reviews"].get(tier["skill"])
        if not entry:
            continue
        concern = entry.get("concern")
        if not isinstance(concern, str) or not concern.strip():
            continue
        ts = entry.get("concern_ts")
        concerns.append({"skill": tier["skill"], "ts": ts if isinstance(ts, str) else _lib.review_ts(entry), "text": _lib.one_line(concern)})
    reason = st["fm"].get("reason")
    reason_text = _lib.one_line(reason) if reason not in (None, "") else ""
    # who wrote the reason and when (`_lib.stamp_reason`); a reason written before 1.3.0 has neither
    by, at = (st["fm"].get(k) for k in ("reason_by", "reason_at"))
    by = _lib.one_line(by) if reason_text and isinstance(by, str) else ""
    at = _lib.one_line(at) if reason_text and isinstance(at, str) else ""
    return {"concerns": concerns, "reason": reason_text or None, "reason_by": by or None, "reason_at": at or None}


def decide(st: dict) -> dict:
    gs = gate_state(st["reviews"], st["fm"], st["status"], st.get("unreadable", 0))
    result = _decide(st, gs)
    named = result.pop("next_log_skill", None)
    result["unreadable"] = gs["unreadable"]
    shown = attention(st, gs["unreadable"])
    result.update(shown)  # concerns, reason, reason_by, reason_at
    if gs["unreadable"] > 0:
        result["next"] = nxt(None, None, True, unreadable_reason(gs["unreadable"]))
        result["optional"] = []
        result["open"] = []
        return result
    # A failed review that is already the next step is not repeated as an Open line.
    result["open"] = [o for o in gs["open"] if o["skill"] != named]
    return result


def _decide(st: dict, gs: dict) -> dict:
    reviews = st["reviews"]
    fm = st["fm"]
    disp = gs["dispositions"]

    def ok(skill: str) -> bool:
        return disp.get(skill) in OK_DISPOSITIONS

    def reason_for(skill: str, missing_reason: str) -> str:
        return blocking_reason(skill, reviews, disp) if disp.get(skill) in BLOCKING else missing_reason

    def first_blocking(exclude: tuple[str, ...] = ()) -> str | None:
        for tier in _lib.gating_tiers():
            if tier["skill"] not in exclude and disp[tier["skill"]] in BLOCKING:
                return tier["skill"]
        return None

    if st["plan"] is None:
        docs = _lib.docs_dir(st["root"], st["cfg"])
        if not (docs / "PRD.md").exists() and not (docs / "IMPLEMENTATION_PLAN.md").exists():
            return {
                "stage": "UNINITIALIZED",
                "next": nxt("/init-project", None, True, "no documentation set yet — interview, stack, docs"),
                "optional": [],
            }
        if st["on_base"]:
            for ep in active_epics(st):
                if ep["next"]:
                    return {
                        "stage": "IDLE",
                        "next": milestone_next(ep, ep["next"]),
                        "optional": [],
                        "epic": epic_summary(ep),
                    }
            return {
                "stage": "IDLE",
                "next": nxt("/office-hours", None, True, "on the base branch with no active epic — start a feature"),
                "optional": [opt("/quickfix", "small, self-contained change")],
            }
        return {
            "stage": "IDLE",
            "next": nxt("/office-hours", None, True, "no plan on this branch — draft one"),
            "optional": [opt("/quickfix", "small, self-contained change")],
        }

    if st["plan_kind"] == "epic":
        ep = st["epic"]
        result = {"stage": "EPIC", "optional": [], "epic": epic_summary(ep)}
        if ep["done"]:
            result["stage"] = "EPIC (complete)"
            result["next"] = nxt(None, None, False, "all milestones shipped or subsumed — close the epic")
        elif not ok("plan-ceo-review"):
            result["next"] = nxt("/plan-ceo-review", None, True, reason_for("plan-ceo-review", "epic needs a CEO review before its milestones start"))
            result["next_log_skill"] = "plan-ceo-review"
        elif ep["next"]:
            result["next"] = milestone_next(ep, ep["next"])
        else:
            result["next"] = nxt("/office-hours", None, True, "epic has no milestones yet — define them")
        return result

    status = st["status"]
    result: dict = {"stage": "PLANNING", "optional": []}
    if st["epic"]:
        result["epic"] = epic_summary(st["epic"], st["milestone"])

    def require(skill: str, missing_reason: str) -> None:
        result["next"] = nxt(_lib.tier_for(skill)["invoke"], None, True, reason_for(skill, missing_reason))
        result["next_log_skill"] = skill

    if status == "shipped":
        result["stage"] = "SHIPPED"
        result["next"] = nxt(None, None, False, "merge the PR")
    elif status == "abandoned":
        result["stage"] = "ABANDONED"
        result["next"] = nxt("/office-hours", None, True, "plan abandoned — supersede it with a new plan")
    elif status in ("blocked", "needs-context"):
        result["stage"] = "BLOCKED" if status == "blocked" else "BLOCKED (needs-context)"
        reason = fm.get("reason")
        text = _lib.one_line(reason, _lib.DISPLAY_LIMIT) if reason else ""  # never raw: a reason is free text
        why = "resolve the blocker first" + (f": {text}" if text else "")
        result["next"] = nxt("/execute-plan", None, True, why)
    elif status == "implementing":
        progress = st["progress"]
        result["stage"] = f"IMPLEMENTING ({progress[0]}/{progress[1]} steps)" if progress else "IMPLEMENTING"
        result["next"] = nxt("/execute-plan", None, True, "continue implementation")
    elif status == "ready-for-review":
        result["stage"] = "READY FOR REVIEW"
        blocking = first_blocking(exclude=("review-implementation",))
        if not ok("review-implementation"):
            require("review-implementation", "pre-landing review")
        elif blocking:
            require(blocking, "")
        elif not ok("final-review"):
            require("final-review", "shipping gate")
            if _lib.truthy(fm.get("ui_scope")):
                if disp["qa"] == "missing":
                    result["optional"].append(opt("/qa", "ui_scope is set and QA has not run"))
                if disp["design-review"] == "missing":
                    result["optional"].append(opt("/design-review", "ui_scope is set and the design audit has not run"))
        else:
            result["next"] = nxt("/ship", None, True, "implementation and final reviews are clean")
    else:
        risk_tags = fm.get("risk_tags")
        if isinstance(risk_tags, str):
            risk_tags = [t.strip() for t in risk_tags.split(",") if t.strip()]
        if not ok("plan-eng-review"):
            require("plan-eng-review", "shipping gate")
            if disp["plan-ceo-review"] == "missing":
                result["optional"].append(opt("/plan-ceo-review", "scope review before the gate"))
        else:
            # Eng review is ok. Adversarial review is suggested from here on, before any
            # further gate, whenever the plan carries risk tags and it has never run.
            if risk_tags and disp["plan-adversarial-review"] == "missing":
                result["optional"].append(opt("/plan-adversarial-review", f"risk tags: {line_text(','.join(map(str, risk_tags)))}"))
            blocking = first_blocking(exclude=("plan-eng-review",))
            if _lib.truthy(fm.get("ui_scope")) and not ok("plan-design-review"):
                require("plan-design-review", "ui_scope is set")
            elif blocking:
                require(blocking, "")
            else:
                result["next"] = nxt("/execute-plan", None, True, "plan is cleared for implementation")
                if disp["plan-ceo-review"] == "missing":
                    result["optional"].append(opt("/plan-ceo-review", "not yet run"))
    return result


# --------------------------------------------------------------------------
# Rendering
# --------------------------------------------------------------------------


def fmt_next(decision: dict) -> list[str]:
    n = decision["next"]
    if n["skill"]:
        head = n["skill"] + (f" {n['args']}" if n.get("args") else "")
        kind = "required" if n["required"] else "optional"
        lines = [f"Next:    {head} — {kind} ({n['reason']})"]
    else:
        lines = [f"Next:    {n['reason']}"]
    for o in decision.get("optional", []):
        lines.append(f"Optional: {o['skill']} — {o['reason']}")
    for o in decision.get("open", []):
        lines.append(f"Open:    {o['invoke']} — {o['reason']}")
    return lines


def reason_author(shown: dict) -> str:
    """`/execute-plan (2026-09-18): ` in front of a reason, from whatever is known: the author,
    the date, both, or nothing for a reason written before it was stamped. `operator` is a person,
    not a skill, so it takes no slash."""
    by, at = shown.get("reason_by"), shown.get("reason_at")
    who = "" if not by else "operator" if by == "operator" else invoke_of(line_text(by))
    label = " ".join(part for part in (who, f"({line_text(at)[:10]})" if at else "") if part)
    return f"{label}: " if label else ""


def fmt_attention(decision: dict) -> list[str]:
    """`Concern:` lines then one `Reason:` line, directly under the Open: lines. The Reason:
    line is suppressed when its full flattened text repeats a displayed concern (skills that
    finish DONE_WITH_CONCERNS write the same text to both places) and when the Next: line
    already carries it: the BLOCKED stages of a feature plan. A blocked epic's Next: line never
    does, so its Reason: line prints. Each fragment is cut at DISPLAY_LIMIT; the comparison uses
    the full text."""
    lines = []
    seen: set[str] = set()
    for c in decision.get("concerns", []):
        seen.add(c["text"])
        lines.append(f"Concern: {invoke_of(c['skill'])} ({c['ts'][:10]}): {_lib.one_line(c['text'], _lib.DISPLAY_LIMIT)}")
    reason = decision.get("reason")
    if reason and not str(decision.get("stage", "")).startswith("BLOCKED") and reason not in seen:
        lines.append(f"Reason:  {reason_author(decision)}{_lib.one_line(reason, _lib.DISPLAY_LIMIT)}")
    return lines


def fmt_reviews(dispositions: dict) -> str:
    """One mark per tier. gates=True: — missing, ✓ ok, ! blocking (failed or stale).
    gates=False (display only): — missing, · present; never ✓ or !, because neither means
    anything for it."""
    parts = []
    for tier in _lib.REVIEW_TIERS:
        d = dispositions.get(tier["skill"], "missing")
        if d == "missing":
            mark = "—"
        elif not tier["gates"]:
            mark = "·"
        elif d in OK_DISPOSITIONS:
            mark = "✓"
        else:
            mark = "!"
        parts.append(f"{tier['short']} {mark}")
    return "  ".join(parts)


def fmt_warn(unreadable: int) -> str:
    return f"Warn:    {unreadable} unreadable review-log line(s) — resolve the conflict (keep both sides) before any review command"


def fmt_epic_line(ep_summary: dict) -> str:
    parts = []
    if ep_summary.get("milestone"):
        pos = line_text(ep_summary["milestone"])
        if ep_summary.get("index"):
            pos += f" of {ep_summary['total']}"
        parts.append(pos)
    else:
        parts.append(f"{ep_summary['total']} milestones")
    detail = f"{ep_summary['shipped']} shipped"
    if ep_summary["subsumed"]:
        detail += f", {ep_summary['subsumed']} subsumed"
    return f"{line_text(ep_summary['slug'])} — {' '.join(parts)} ({detail})"


def fmt_epic_row(ep: dict) -> str:
    counts = [f"{ep['shipped']} shipped"]
    if ep["subsumed"]:
        counts.append(f"{ep['subsumed']} subsumed")
    if ep["in_progress"]:
        counts.append(f"{ep['in_progress']} in progress")
    done = ep["shipped"] + ep["subsumed"]
    line = f"{line_text(ep['slug'])}  {done}/{ep['total']} done ({', '.join(counts)})"
    nm = ep.get("next")
    if nm:
        where = f" — {line_text(nm['status'])}" + (f" on {line_text(nm['branch'])}" if nm.get("branch") else "") if nm["status"] != "not-started" else ""
        line += f"  next: {line_text(nm['id'])} ({line_text(nm['size'])}) {line_text(nm['title'])}{where}".rstrip()
    elif ep["done"]:
        line += "  complete"
    else:
        line += "  no milestones"
    return line


def banner_lines(st: dict, decision: dict) -> list[str]:
    lines = ["━━━ Workflow Status ━━━"]
    if decision.get("unreadable"):
        lines.append(fmt_warn(decision["unreadable"]))
    lines.append(f"Branch:  {st['branch']}")
    plan = st["plan"]
    lines.append(f"Plan:    {plan.name if plan else 'none'}")
    if plan and decision.get("epic"):
        lines.append(f"Epic:    {fmt_epic_line(decision['epic'])}")
    stage = decision["stage"]
    if st["on_base"] and not plan:
        stage += " — on base branch"
    lines.append(f"Stage:   {stage}")
    if plan:
        gs = gate_state(st["reviews"], st["fm"], st["status"], st.get("unreadable", 0))
        lines.append(f"Reviews: {fmt_reviews(gs['dispositions'])}")
    if st["on_base"]:
        for ep in active_epics(st):
            lines.append(f"Epic:    {fmt_epic_row(ep)}")
        if st["stuck"]:
            items = ", ".join(f"{e['branch']} ({e['status']})" for e in st["stuck"])
            lines.append(f"Warn:    {len(st['stuck'])} plan(s) stuck on other branches: {items}")
    lines.extend(fmt_next(decision))
    lines.extend(fmt_attention(decision))
    lines.append(f"Note:    {HARNESS_NOTE}")
    return lines


def dashboard(st: dict) -> dict:
    plan = st["plan"]
    if not plan:
        return {"plan": None, "rows": [], "verdict": "NO PLAN", "missing": [], "missing_to_ship": [], "unreadable": st.get("unreadable", 0), "concerns": [], "reason": None, "reason_by": None, "reason_at": None}
    reviews = st["reviews"]
    gs = gate_state(reviews, st["fm"], st["status"], st.get("unreadable", 0))
    rows = []
    for tier in _lib.REVIEW_TIERS:
        entry = reviews.get(tier["skill"])
        disposition = gs["dispositions"][tier["skill"]]
        rows.append(
            {
                "label": tier["label"],
                "skill": tier["skill"],
                "status": entry.get("status") if entry else None,
                "disposition": disposition,
                "gates": tier["gates"],
                "ok": disposition in OK_DISPOSITIONS,
                "when": _lib.review_ts(entry)[:10] if entry else None,
                "extra": _lib.review_extra(entry) if entry else {},
            }
        )
    shown = attention(st, gs["unreadable"])
    return {
        "plan": plan.name,
        "ui_scope": _lib.truthy(st["fm"].get("ui_scope")),
        "rows": rows,
        "verdict": gs["verdict"],
        "missing": gs["missing"],
        "missing_to_ship": gs["missing_to_ship"],
        "unreadable": gs["unreadable"],
        **shown,  # concerns, reason, reason_by, reason_at
    }


def fmt_extra(extra: dict) -> str:
    """Same rule as `_lib.fmt_review_value`: quote any value that would split the row."""
    return ",".join(f"{k}={_lib.fmt_review_value(v)}" for k, v in sorted(extra.items()))


def fmt_missing(names: list[str], rows: list[dict]) -> str:
    disposition = {r["skill"]: r["disposition"] for r in rows}
    suffix = {"failed": " (issues open)", "stale": " (re-review demanded)"}
    return ", ".join(f"{n}{suffix.get(disposition.get(n), '')}" for n in names)


def dashboard_lines(d: dict) -> list[str]:
    if not d["plan"]:
        return ["no plan on this branch"]
    lines = []
    if d.get("unreadable"):
        lines.append(f"Warn: {d['unreadable']} unreadable review-log line(s)")
    lines += [f"Plan: {d['plan']}", f"{'Review':<13}| {'Status':<14}| {'When (UTC)':<11}| Extra"]
    for r in d["rows"]:
        if r["status"] is None:
            status = "—"
        elif not r["gates"]:
            status = str(r["status"])
        elif r["disposition"] == "stale":
            status = "stale !"  # the one row whose text cell shows the disposition: the logged word is clean
        else:
            status = f"{r['status']} {'✓' if r['ok'] else '!'}"
        lines.append(f"{r['label']:<13}| {status:<14}| {r['when'] or '':<11}| {fmt_extra(r['extra'])}")
    verdict = f"Verdict: {d['verdict']}"
    if d["verdict"] == "NOT CLEARED":
        verdict += f" — missing: {fmt_missing(d['missing'], d['rows'])}"
    lines.append(verdict)
    if d["verdict"] == "CLEARED FOR IMPLEMENTATION":
        lines.append(f"To ship: {fmt_missing(d['missing_to_ship'], d['rows'])}")
    reason = d.get("reason")
    if reason and reason not in {c["text"] for c in d.get("concerns", [])}:
        lines.append(f"Reason: {reason_author(d)}{reason}")  # in full: the dashboard is the untruncated view
    return lines


def history(root: Path, cfg: dict, limit: int) -> list[dict]:
    rows = []
    for key, entry in _lib.registry_all(root, cfg).items():
        status = entry.get("implementation_status") or entry.get("status")
        completed = entry.get("completed")
        if status != "shipped" and not completed:
            continue
        kind = entry.get("kind") or (key.split(":", 1)[0] if ":" in key else "feature")
        if kind == "plan":
            kind = "feature"
        if kind == "feature" and entry.get("parent_epic"):
            kind = "milestone"
        rows.append(
            {
                "date": str(completed or (entry.get("updated_at") or ""))[:10],
                "kind": kind,
                "key": key,
                "title": entry.get("title") or "",
                "branch": entry.get("branch") or "",
                "ref": entry.get("plan") or entry.get("commit") or "",
                "updated_at": entry.get("updated_at") or "",
            }
        )
    rows.sort(key=lambda r: (r["date"], r["updated_at"]), reverse=True)
    return rows[:limit]


def history_lines(rows: list[dict]) -> list[str]:
    if not rows:
        return ["(no completions recorded)"]
    out = []
    for r in rows:
        title = f" — {r['title']}" if r["title"] else ""
        out.append(f"{r['date']}  {r['kind']:<10} {r['key']}{title}  [{r['branch']}]  {r['ref']}")
    return out


# --------------------------------------------------------------------------
# Entry point
# --------------------------------------------------------------------------


def parse_args(argv: list[str]) -> argparse.Namespace:
    ap = argparse.ArgumentParser(prog="workflow-state", add_help=True)
    mode = ap.add_mutually_exclusive_group()
    mode.add_argument("--next", action="store_true")
    mode.add_argument("--dashboard", action="store_true")
    mode.add_argument("--history", nargs="?", type=int, const=10, default=None, metavar="N")
    mode.add_argument("--epics", action="store_true")
    ap.add_argument("--json", action="store_true")
    return ap.parse_args(argv)


def main() -> int:
    args = parse_args(sys.argv[1:])
    explicit = args.next or args.dashboard or args.history is not None or args.epics

    if not explicit:
        # Banner: fail silent, this runs on every session start.
        try:
            root = _lib.repo_root()
            cfg = _lib.load_config(root)
            st = gather(root, cfg)
            if not st["branch"]:
                return 0
            text = _lib.encodable("\n".join(banner_lines(st, decide(st))))  # a print that raises here is a blank banner
            if args.json:
                sys.stdout.write(
                    json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": text}})
                )
            else:
                print(text)
        except Exception:  # noqa: BLE001 - intentional: never break a session start
            pass
        return 0

    root = _lib.repo_root()
    cfg = _lib.load_config(root)

    if args.epics:
        epics = [_lib.epic_progress(root, cfg, slug) for slug in _lib.all_epic_slugs(root, cfg)]
        if args.json:
            return _lib.print_json(epics)
        print("\n".join(fmt_epic_row(ep) for ep in epics) if epics else "(no epics)")
        return 0

    if args.history is not None:
        rows = history(root, cfg, args.history)
        if args.json:
            return _lib.print_json(rows)
        print("\n".join(history_lines(rows)))
        return 0

    st = gather(root, cfg)
    if args.dashboard:
        d = dashboard(st)
        if args.json:
            return _lib.print_json(d)
        print(_lib.encodable("\n".join(dashboard_lines(d))))
        return 0

    decision = decide(st)
    if args.json:
        return _lib.print_json(decision)
    lines = []
    if decision.get("unreadable"):
        lines.append(fmt_warn(decision["unreadable"]))
    lines += [f"Stage:   {decision['stage']}"] + fmt_next(decision) + fmt_attention(decision) + [f"Note:    {HARNESS_NOTE}"]
    print(_lib.encodable("\n".join(lines)))
    return 0


if __name__ == "__main__":
    _lib.run_main(main)
