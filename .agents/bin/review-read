#!/usr/bin/env python3
"""Read the review log.

Usage:
    review-read [--json]              latest entry per skill for the current branch's plan
    review-read --plan NAME [--json]  same, for a named plan file
    review-read --all [--json]        every entry, newest first, with the plan column

Text output, one line per row; `disposition` is passed, failed, or resolved
(see `_lib.review_disposition`):
    plan mode:  skill|ts|status|disposition|k=v,k=v
    --all:      plan|skill|ts|status|disposition|k=v,k=v
JSON output: {"plan": NAME, "reviews": {skill: entry}} or {"entries": [entry, ...]}; every
entry carries "disposition". A log with unreadable lines is an error (exit 2; the envelope
names the lines and carries "unreadable": N); nothing is printed as if a partial parse were
the whole log.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _lib  # noqa: E402


def parse_args(argv: list[str]) -> argparse.Namespace:
    ap = argparse.ArgumentParser(prog="review-read")
    scope = ap.add_mutually_exclusive_group()
    scope.add_argument("--plan", help="plan basename to filter on")
    scope.add_argument("--all", action="store_true", help="every entry, newest first")
    ap.add_argument("--json", action="store_true")
    return ap.parse_args(argv)


def fmt_extra(entry: dict) -> str:
    return ",".join(f"{k}={_lib.fmt_review_value(v)}" for k, v in sorted(_lib.review_extra(entry).items()))


def with_disposition(entry: dict) -> dict:
    return dict(entry, disposition=_lib.review_disposition(entry))


def main() -> int:
    args = parse_args(sys.argv[1:])
    root = _lib.repo_root()
    cfg = _lib.load_config(root)

    entries, bad = _lib.review_log_scan(root, cfg)
    if bad:
        raise _lib.FrameworkError(_lib.unreadable_message(bad), code=2, unreadable=len(bad), lines=bad)

    if args.all:
        entries = sorted(entries, key=_lib.review_ts, reverse=True)
        if args.json:
            return _lib.print_json({"entries": [with_disposition(e) for e in entries]})
        if not entries:
            print("(no reviews logged)")
            return 0
        for e in entries:
            print(
                f"{e.get('plan') or '-'}|{e.get('skill', '')}|{e.get('ts', '')}|{e.get('status', '')}"
                f"|{_lib.review_disposition(e)}|{fmt_extra(e)}"
            )
        return 0

    plan_name = args.plan
    if plan_name:
        plan_name = _lib.review_plan_name({"plan": plan_name}) or plan_name
    if not plan_name:
        branch = _lib.current_branch(root)
        plan = _lib.latest_plan(root, cfg, branch) if branch else None
        if not plan:
            if args.json:
                return _lib.print_json({"plan": None, "reviews": {}})
            print("(no plan on this branch)")
            return 0
        plan_name = plan.name

    reviews = _lib.reviews_for_plan(root, cfg, plan_name)
    if args.json:
        return _lib.print_json({"plan": plan_name, "reviews": {k: with_disposition(v) for k, v in reviews.items()}})
    if not reviews:
        print(f"(no reviews for plan: {plan_name})")
        return 0
    for skill, e in sorted(reviews.items(), key=lambda kv: _lib.review_ts(kv[1])):
        print(f"{skill}|{e.get('ts', '')}|{e.get('status', '')}|{_lib.review_disposition(e)}|{fmt_extra(e)}")
    return 0


if __name__ == "__main__":
    _lib.run_main(main)
