# Copy this file to backend/.env (the filename must be exactly .env) and
# fill in any values your local stack needs beyond the Postgres defaults.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=todo_app

DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# M5 PR1 — auth secrets are REQUIRED for protected routes (anything that's
# not /, /healthz, /auth/*, /uploads/*). Without them,
# every protected request returns 500 and the app is unusable. Generate a
# JWT secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY must be ≥32 chars and must NOT contain any of:
# changeme, change-me, your-secret, your_secret, placeholder, example,
# replace-me, replace_me, todo, default, insecure, test-key, test_key.
# HOUSEHOLD_ACCESS_KEY can be any non-empty string — it gates /auth/register
# so only people with the shared key can create the singleton account.
JWT_SECRET_KEY=
HOUSEHOLD_ACCESS_KEY=

# REQUIRED — Fernet key for encrypting stored iCloud app-specific passwords.
# The api and celery containers read it; without it the iCloud integration
# endpoints and the sync tasks fail at call time. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# OPTIONAL — AI recipe import (POST /items/import-from-url) and icon suggest
# (POST /items/suggest-icon). Leave ANTHROPIC_API_KEY empty to disable both;
# the rest of the app is unaffected. AI_MODEL_NAME defaults to the value in
# docker-compose.yml when unset.
ANTHROPIC_API_KEY=
# AI_MODEL_NAME=claude-haiku-4-5-20251001

# M7 storage. Default `local` writes to UPLOAD_DIR (dev/test/PR1 prod).
# PR2 flips production to `r2`. Unknown values crash on first upload rather
# than silently writing to ephemeral disk. R2_* secrets are already on Fly.
# STORAGE_BACKEND=local
# SQLALCHEMY_ECHO=false

# APP_ENV controls fail-closed behavior. Leave unset for local dev (auth
# config errors degrade to a warning); set to "production" only in real
# production where missing/invalid auth secrets MUST crash startup.
APP_ENV=development
